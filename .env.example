# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#   1. Copy it to a file named .env in the same folder
#        Windows:  copy .env.example .env      (setup.cmd does this for you)
#        Mac/Linux: cp .env.example .env
#   2. Get a free Gemini API key: https://aistudio.google.com/apikey
#   3. Paste it after GEMINI_API_KEY= below, with no spaces or quotes, e.g.
#        GEMINI_API_KEY=AIzaSy...your-key...
#   .env is git-ignored: your key stays on your machine and is never committed.
#
# Nothing here is needed for the offline test suite or the validation gate --
# only the extraction layer and the help agent call an API.
# ---------------------------------------------------------------------------

# Which provider the extraction layer calls: gemini | anthropic
LUCIDFORM_EXTRACTION_PROVIDER=gemini

# Gemini (read without the LUCIDFORM_ prefix; GOOGLE_API_KEY also works)
# >>> PASTE YOUR GEMINI API KEY AFTER THE = SIGN <<<
GEMINI_API_KEY=
LUCIDFORM_GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic. The SDK also resolves an `ant auth login` profile, so a key may be
# unnecessary. Swap the model to run the accuracy sweep across tiers:
#   claude-opus-5-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_API_KEY=
LUCIDFORM_EXTRACTION_MODEL=claude-opus-5-5

# Candidates below this confidence are rejected by the gate as LOW_CONFIDENCE.
LUCIDFORM_MIN_CONFIDENCE=0.55

LUCIDFORM_LANG=en

# Optional: web scraping when refreshing help-agent sources
FIRECRAWL_API_KEY=
